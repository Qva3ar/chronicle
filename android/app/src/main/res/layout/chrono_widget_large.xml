<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <!-- Icon -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡"
            android:textSize="24sp"
            android:layout_marginEnd="12dp" />

        <!-- App Name -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chrono Insights"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Insight Title -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chrono"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="12dp" />

    <!-- Insight Body -->
    <TextView
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="No insights yet. Check back soon for personalized recommendations."
        android:textColor="#CCCCCC"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginBottom="16dp" />

    <!-- Tags -->
    <TextView
        android:id="@+id/widget_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFC107"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <!-- Open Insight Button -->
        <Button
            android:id="@+id/widget_button_open_insight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View"
            android:textSize="12sp"
            android:background="@drawable/widget_button_background"
            android:textColor="#FFFFFF"
            android:padding="10dp"
            android:minWidth="70dp"
            android:layout_marginEnd="8dp" />

        <!-- Create Note Button -->
        <Button
            android:id="@+id/widget_button_create_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Note"
            android:textSize="12sp"
            android:background="@drawable/widget_button_background"
            android:textColor="#FFFFFF"
            android:padding="10dp"
            android:minWidth="80dp" />
    </LinearLayout>
</LinearLayout>
