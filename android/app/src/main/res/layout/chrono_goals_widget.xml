                     <TextView
                        android:id="@+id/goal_total_time_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" / 00:00:00"
                        android:textColor="#C3C5C9"
                        android:textSize="12sp"
                        android:layout_marginTop="0dp" />
                </LinearLayout>

                <LinearLayout
