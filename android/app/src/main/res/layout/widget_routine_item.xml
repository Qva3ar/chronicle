<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/widget_routine_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:background="@drawable/widget_card_background"
        android:gravity="center_vertical">

        <!-- Checkbox Container -->
        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp">
            
            <!-- Using ImageView instead of ImageButton for list items, simpler handling -->
            <ImageView
                android:id="@+id/routine_checkbox_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_checkbox_off"
                android:contentDescription="Toggle routine" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/routine_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Routine Name"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="normal"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/routine_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00 - Days"
                android:textColor="#C3C5C9"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
        
        <LinearLayout
            android:id="@+id/routine_streak_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/widget_streak_background"
            android:gravity="center_vertical"
            android:layout_marginStart="8dp">
            
            <TextView
                android:id="@+id/routine_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥5"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#C3C5C9"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>