<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Include the database and important app data -->
    <include domain="file" path="." />
    
    <!-- Exclude temporary files and cache -->
    <exclude domain="file" path="cache" />
    <exclude domain="file" path="code_cache" />
    
    <!-- Include shared preferences for settings -->
    <include domain="sharedpref" path="." />
    
    <!-- Include the databases directory to ensure SQLite files are backed up -->
    <include domain="database" path="." />
</full-backup-content>